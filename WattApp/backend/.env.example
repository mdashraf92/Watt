# ── GO WATT backend config (copy to .env, fill in) ──────────────────────────
NODE_ENV=production
PORT=8080

# PostgreSQL on your dedicated server
DATABASE_URL=postgres://gowatt:CHANGE_ME@localhost:5432/gowatt

# Auth tokens (generate strong random values: openssl rand -hex 48)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS — the app's origin(s); use * only for early testing
CORS_ORIGIN=*

# SMTP (password reset / verification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gowatt.om

# Integrations (ported from the edge functions)
# Self-hosted OSRM for in-app driving directions (see docs/SELF_HOSTING.md).
# Leave blank until deployed - /api/routing/route then returns 503 and the app
# tells the user directions are unavailable rather than crashing.
OSRM_URL=

THAWANI_BASE_URL=https://checkout.thawani.om
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=

# SMS / phone-OTP (iSmartSMS by Infocomm, Oman). Leave blank for local dev —
# OTP codes are printed to the backend console instead of being texted. Fill all
# three (values provided by Infocomm) to send real SMS. ISMARTSMS_HEADER is the
# registered sender ID (≤11 chars).
# NOTE: this file is COMMITTED and the repo is public — never put real values
# here. Real credentials belong in .env (gitignored) only.
ISMARTSMS_USER_ID=
ISMARTSMS_PASSWORD=
ISMARTSMS_HEADER=
# Endpoint. Infocomm run several and each account is enabled for one of them, so
# the wrong URL returns code 3 ("user or password is wrong") even when the
# credentials are correct. Ours is SMSDynamicAPI (the default in config/env.ts).
# To identify an account's endpoint, POST to each with MobileNo=1: code 9
# (invalid mobile) means auth passed, code 3 means try the next one.
# ISMARTSMS_URL=https://www.ismartsms.net/iBulkSMS/HttpWS/SMSDynamicAPI.aspx

# Background-job internal secret (cron → protected job endpoints)
JOB_SECRET=CHANGE_ME
