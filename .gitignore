# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
*.iml
.idea/
.idea_backup/
.vscode/*
!.vscode/settings.json

# ── Local tooling — not part of the product ────────────────────────────────
.mcp.json
.claude/
WattApp/supabase/.temp/

# ── Personal / sensitive — never commit ────────────────────────────────────
# (kept from the original ignore list; paths updated after the 2026-07 tidy-up)
Bills/
docs/reports/hardware.pdf
docs/planning/lastupdate.md
marketing/index.html

# ── Database dumps ─────────────────────────────────────────────────────────
# ~19MB of restored-from-cloud data. Kept locally for the dev DB, never in git.
WattApp/db/dumps/
*.dump

# ── Dependencies ───────────────────────────────────────────────────────────
node_modules/

# ── Build output ───────────────────────────────────────────────────────────
# NOTE: `build/` here is why the website's build scripts live in site/tools/
# rather than site/build/ — the latter would be silently ignored.
build/
dist/

# ── Website build artefacts ────────────────────────────────────────────────
# The built site IS committed (it is what go-watt.com serves), so css/, js/,
# fonts/, i18n/ and data/ at the repo root are deliberately NOT ignored.
site/.cache/

# ── Vendor documents ───────────────────────────────────────────────────────
# Integration specs supplied by providers under confidentiality. This repo is
# public, so keep them local — Infocomm's SMS spec is marked "Company
# Confidential". Thawani's OpenAPI file is published by Thawani and may stay.
iSmartSMS*.pdf
.gstack/
